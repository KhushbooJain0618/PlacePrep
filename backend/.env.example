# PlacePrep Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
JWT_SECRET=placeprep-dev-secret-key-2026

# Mode Toggle: Set to false when connecting to live Azure AI keys
USE_MOCK_AI=true

# -------------------------------------------------------------
# Microsoft Azure AI Services Configuration
# -------------------------------------------------------------

# Azure OpenAI / Microsoft Foundry LLM (Required for live Chat & Interview AI)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Microsoft Foundry Project (Alternative to Azure OpenAI)
AZURE_PROJECT_ENDPOINT=
AZURE_API_KEY=

# Azure AI Search (Required for live RAG grounding)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key
AZURE_SEARCH_INDEX_NAME=placement-knowledge-index

# Azure AI Speech (Required for live STT & TTS speech services)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-JennyNeural

# Azure AI Vision (Optional for camera frame telemetry)
AZURE_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com
AZURE_VISION_KEY=your_azure_vision_key

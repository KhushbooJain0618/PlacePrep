# PlacePrep Frontend Environment Configuration
# Set these in your Vercel Project Settings for placeprep-frontend

# Option A: Direct Backend API URL (Client connects directly to backend)
# Set to your deployed Vercel backend URL + /api
NEXT_PUBLIC_API_URL=https://placeprep-backend.vercel.app/api

# Option B: Server Proxy (Next.js automatically proxies /api calls server-side)
# Set to your deployed Vercel backend base URL (no /api)
BACKEND_URL=https://placeprep-backend.vercel.app

# Development Mock Mode flag (optional, default: false in production)
NEXT_PUBLIC_USE_MOCK_AI=false

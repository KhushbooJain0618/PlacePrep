# PlacePrep Environment Configuration
# Toggle Development Mock Mode (Set to true to run without live Azure keys)
USE_MOCK_AI=true

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Next.js Public Configuration (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_USE_MOCK_AI=true

# Microsoft Foundry / Azure OpenAI Service (Optional in Mock Mode)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Microsoft Foundry Project Endpoint
AZURE_PROJECT_ENDPOINT=https://your-foundry-project.services.ai.azure.com/
AZURE_API_KEY=your_foundry_api_key

# Azure AI Search (Knowledge Grounding / RAG)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key
AZURE_SEARCH_INDEX_NAME=placement-knowledge-index

# Azure AI Speech (Speech-to-Text & Text-to-Speech)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# Azure AI Vision (Interaction presence signals)
AZURE_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_azure_vision_key
